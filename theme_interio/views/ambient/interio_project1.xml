<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="interio_project1" name="Project">
        <section class="interio_project1 ip1-section">
            <div class="container">
                <div class="row mb-5">
                    <div class="col-12 text-center">
                        <h2 class="ip1-title ip1-anim">Featured Projects</h2>
                        <div class="ip1-divider ip1-anim"></div>
                        <p class="ip1-subtitle ip1-anim">Curated excellence in architectural design</p>
                    </div>
                </div>
                
                <div class="row g-4">
                    <!-- Project 1 -->
                    <div class="col-lg-4 col-md-6">
                        <div class="ip1-card ip1-anim">
                            <div class="ip1-img-wrap">
                                <img src="/theme_interio/static/src/img/hero2_slide_1.png" alt="Project 1" class="img-fluid ip1-img"/>
                                <div class="ip1-overlay">
                                    <a href="#" class="ip1-btn">View Project</a>
                                </div>
                            </div>
                            <div class="ip1-content">
                                <span class="ip1-category">Residential</span>
                                <h3 class="ip1-name">Villa Serenity</h3>
                                <p class="ip1-desc">A modern approach to sustainable living with open spaces.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Project 2 -->
                    <div class="col-lg-4 col-md-6">
                        <div class="ip1-card ip1-anim" style="transition-delay: 0.2s;">
                            <div class="ip1-img-wrap">
                                <img src="/theme_interio/static/src/img/crafted_1_ny.png" alt="Project 2" class="img-fluid ip1-img"/>
                                <div class="ip1-overlay">
                                    <a href="#" class="ip1-btn">View Project</a>
                                </div>
                            </div>
                            <div class="ip1-content">
                                <span class="ip1-category">Commercial</span>
                                <h3 class="ip1-name">Apex Tower</h3>
                                <p class="ip1-desc">Corporate headquarters designed for collaboration and light.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Project 3 -->
                    <div class="col-lg-4 col-md-6">
                        <div class="ip1-card ip1-anim" style="transition-delay: 0.4s;">
                            <div class="ip1-img-wrap">
                                <img src="/theme_interio/static/src/img/hero3_img_3.png" alt="Project 3" class="img-fluid ip1-img"/>
                                <div class="ip1-overlay">
                                    <a href="#" class="ip1-btn">View Project</a>
                                </div>
                            </div>
                            <div class="ip1-content">
                                <span class="ip1-category">Interior</span>
                                <h3 class="ip1-name">Obsidian Lounge</h3>
                                <p class="ip1-desc">Dark tones and rich textures defining modern luxury.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
