<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ambient_contact" name="Ambient Contact">
        <section class="ambient_contact_section">
            <div class="container">
                <div class="row align-items-center">
                    <!-- Contact Info Side -->
                    <div class="col-lg-5 mb-5 mb-lg-0">
                        <div class="contact-header">
                            <h2 class="section-title">Let's Create <br/><span class="highlight">Something Timeless</span></h2>
                            <p class="section-desc">Reach out to us for inquiries, collaborations, or just to share your vision. We are ready to listen.</p>
                        </div>
                        
                        <div class="contact-cards-container">
                            <!-- Card 1: Email -->
                            <div class="contact-card">
                                <div class="icon-box">
                                    <i class="fa fa-envelope-o"></i>
                                </div>
                                <div class="content-box">
                                    <h4>Email Us</h4>
                                    <a href="mailto:hello@interio.com" class="link-hover">hello@interio.com</a>
                                </div>
                                <div class="hover-overlay"></div>
                            </div>
                            
                            <!-- Card 2: Phone -->
                            <div class="contact-card">
                                <div class="icon-box">
                                    <i class="fa fa-phone"></i>
                                </div>
                                <div class="content-box">
                                    <h4>Call Us</h4>
                                    <a href="tel:+1234567890" class="link-hover">+1 (555) 123-4567</a>
                                </div>
                                <div class="hover-overlay"></div>
                            </div>

                            <!-- Card 3: Studio -->
                            <div class="contact-card">
                                <div class="icon-box">
                                    <i class="fa fa-map-marker"></i>
                                </div>
                                <div class="content-box">
                                    <h4>Visit Studio</h4>
                                    <p>123 Design Avenue, Creative District, NY</p>
                                </div>
                                <div class="hover-overlay"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Form Side -->
                    <div class="col-lg-6 offset-lg-1">
                        <div class="ambient-form-wrapper">
                            <form action="#" method="post" class="ambient-form">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <input type="text" required="required" placeholder=" " />
                                            <label>Name</label>
                                            <span class="line"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <input type="email" required="required" placeholder=" " />
                                            <label>Email</label>
                                            <span class="line"></span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="input-group">
                                            <input type="text" placeholder=" " />
                                            <label>Subject</label>
                                            <span class="line"></span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="input-group textarea-group">
                                            <textarea required="required" placeholder=" "></textarea>
                                            <label>Message</label>
                                            <span class="line"></span>
                                        </div>
                                    </div>
                                    <div class="col-12 mt-4">
                                        <button type="submit" class="submit-btn">
                                            <span>Send Message</span>
                                            <i class="fa fa-long-arrow-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
