<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="studio_marquee" name="Studio Marquee">
        <section class="studio-marquee-section">
            <!-- Decorative floating particles -->
            <div class="sm-particles">
                <span class="sm-dot sm-dot-1"></span>
                <span class="sm-dot sm-dot-2"></span>
                <span class="sm-dot sm-dot-3"></span>
                <span class="sm-dot sm-dot-4"></span>
                <span class="sm-dot sm-dot-5"></span>
            </div>

            <!-- Section Header -->
            <div class="container text-center sm-header">
                <div class="sm-tag">Our Portfolio</div>
                <h2 class="sm-title">
                    <span class="sm-title-stroke">Studio</span> Showcase
                </h2>
                <div class="sm-divider">
                    <span class="sm-divider-line"></span>
                    <span class="sm-divider-diamond"></span>
                    <span class="sm-divider-line"></span>
                </div>
                <p class="sm-subtitle">A curated flow of our finest interior works &#x2014; spaces crafted with intention, warmth, and timeless elegance.</p>
            </div>

            <!-- Marquee Row 1 — Left to Right -->
            <div class="sm-marquee-wrapper">
                <div class="sm-marquee-track sm-track-ltr">
                    <!-- Set A -->
                    <div class="sm-marquee-item">
                        <div class="sm-card">
                            <img src="/theme_interio/static/src/img/hero1_slide_1.png" alt="Studio Work 1"/>
                            <div class="sm-card-overlay">
                                <span class="sm-card-label">Minimalist Living</span>
                            </div>
                        </div>
                    </div>
                    <div class="sm-marquee-item">
                        <div class="sm-card">
                            <img src="/theme_interio/static/src/img/hero2_slide_1.png" alt="Studio Work 2"/>
                            <div class="sm-card-overlay">
                                <span class="sm-card-label">Refined Elegance</span>
                            </div>
                        </div>
                    </div>
                    <div class="sm-marquee-item">
                        <div class="sm-card">
                            <img src="/theme_interio/static/src/img/hero3_img_1.png" alt="Studio Work 3"/>
                            <div class="sm-card-overlay">
                                <span class="sm-card-label">Modern Warmth</span>
                            </div>
                        </div>
                    </div>
                    <div class="sm-marquee-item">
                        <div class="sm-card">
                            <img src="/theme_interio/static/src/img/hero4_bg.png" alt="Studio Work 4"/>
