            <!-- Bottom decorative arc -->
            <div class="sm-bottom-art">
                <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
                    <path d="M0,80 C360,0 1080,0 1440,80" fill="none" stroke="rgba(244,223,200,0.15)" stroke-width="1.5"/>
                    <path d="M0,80 C360,20 1080,20 1440,80" fill="none" stroke="rgba(244,223,200,0.08)" stroke-width="1"/>
