                        <div class="ak-content">
                            <h2 class="ak-title">PROJECTS</h2>
                            <p class="ak-subtitle">BE INSPIRED BY INTERIORS</p>
                        </div>
                    </div>
                    <!-- Panel 3 -->
                    <div class="ak-panel" style="background-image: url('/theme_interio/static/src/img/support.png');">
                        <div class="ak-overlay"></div>
                        <div class="ak-content">
                            <h2 class="ak-title">SUPPORT</h2>
                            <p class="ak-subtitle">JUST CHOOSE COMFORT</p>
                        </div>
                    </div>
                </div>
