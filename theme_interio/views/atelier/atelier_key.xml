                        <div class="ak-content">
                            <h2 class="ak-title">OUR TEAM</h2>
                            <p class="ak-subtitle">EXPLORE OUR EXPERTS</p>
                        </div>
                    </div>
                    <!-- Panel 2 -->
                    <div class="ak-panel" style="background-image: url('/theme_interio/static/src/img/hero2_slide_1.png');">
