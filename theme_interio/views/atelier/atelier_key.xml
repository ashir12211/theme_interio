<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="atelier_key" name="Atelier Key Features">
        <section class="atelier-key-section">
            <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&amp;family=Space+Grotesk:wght@300;500;700&amp;display=swap" rel="stylesheet"/>
            <div class="ak-container">
                <div class="ak-accordion">
                    <!-- Panel 1 -->
                    <div class="ak-panel" style="background-image: url('/theme_interio/static/src/img/team.png');">
